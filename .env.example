PORT=8080
DB_PATH=shengen.db
DEV_INSECURE_COOKIES=false

# Adresa na kojoj korisnici otvaraju aplikaciju. Uz token bota, webhook se
# pri startu automatski prijavljuje Telegramu.
PUBLIC_BASE_URL=

# Jedan bot za sve firme (@BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=
# Obavezan kad je token postavljen: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Opciono, bez @ — omogućava linkove za povezivanje na koje se samo tapne.
TELEGRAM_BOT_USERNAME=

# Telegram ID-jevi operatora servisa, razdvojeni zarezom (svoj ID dobijete od
# @userinfobot). Samo oni vide superadmin komande (/admin, /stats, /mrr, …) i
# primaju obaveštenja; svaki operator mora jednom da pošalje /start botu.
ADMIN_TELEGRAM_IDS=
# Opciono: fajl koji backup posle svakog uspešnog prolaza ažurira (touch).
# Ako je stariji od 26h ili ne postoji, operatori dobijaju upozorenje.
BACKUP_HEARTBEAT_FILE=

# Slanje mejlova (reset lozinke; kasnije potvrda registracije i pozivnice)
# preko SMTP releja provajdera, npr. Brevo: smtp-relay.brevo.com, port 587.
# Bez SMTP_HOST se mejlovi u lokalnom razvoju (DEV_INSECURE_COOKIES=true)
# samo ispisuju u log, a na serveru se ne šalju.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Obavezno uz SMTP_HOST, pod navodnicima (zbog < >); domen mora imati DKIM
# i DMARC kod provajdera.
MAIL_FROM="Dani90 <nalog@dani90.rs>"
# Opciono: adresa na koju stižu odgovori korisnika.
MAIL_REPLY_TO=
# Najviše mejlova u 24h (ispod limita provajdera; Brevo besplatno: 300).
MAIL_DAILY_LIMIT=250

# Cloudflare Turnstile na javnim formama (oba ključa ili nijedan).
# Za lokalnu proveru postoje Cloudflare-ovi test ključevi koji uvek prolaze:
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Čitanje skenirane evidencije (PDF, slika) na stranici „Uvoz istorije“.
# Prazno: opcija se ne prikazuje.
ANTHROPIC_API_KEY=
# Poslednji dan važenja ključa (GGGG-MM-DD): superadmin dobija podsetnik
# 5 dana ranije. Prazno: bez podsetnika.
ANTHROPIC_API_KEY_EXPIRES=
